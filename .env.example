# Salin ke .env.local lalu isi. Jangan pernah commit nilai asli (repo publik).

# MySQL 8 — mysql://user:password@host:port/database
DATABASE_URL=
# Isi 1 untuk koneksi TLS (production); DB_SSL_CA opsional (PEM, \n di-escape)
DB_SSL=
DB_SSL_CA=

# Penandatangan cookie sesi & kunci enkripsi payload job (string acak panjang)
AUTH_SECRET=
# URL publik aplikasi (dipakai tautan di email)
APP_URL=

# Pepper hash password Sales Hub lama (Script Property USER_PASSWORD_PEPPER) —
# hanya untuk memverifikasi hash hmac256$ lama; diisi saat migrasi data.
LEGACY_PASSWORD_PEPPER=

# Microsoft Graph (kirim email). Gunakan client secret yang SUDAH di-rotate.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_MAILBOX=

# Google service account (template PDF & file Drive) — isi JSON kunci dalam satu baris
GOOGLE_SERVICE_ACCOUNT_JSON=

# Penyapu antrean job (/api/cron/jobs): header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Rate limit (opsional; kosong = nonaktif)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# npm run bootstrap:admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAMA=

# npm run seed:dev (password semua user contoh; hanya database dev/test)
SEED_PASSWORD=
