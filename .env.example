# Salin ke .env.local lalu isi. Jangan pernah commit nilai asli.

# MySQL 8 — mysql://user:password@host:port/database
DATABASE_URL=
# Isi 1 untuk koneksi TLS (production); DB_SSL_CA opsional (PEM, \n di-escape)
DB_SSL=
DB_SSL_CA=

# Penandatangan cookie sesi (string acak panjang)
AUTH_SECRET=

# Rate limit (opsional; kosong = nonaktif)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
